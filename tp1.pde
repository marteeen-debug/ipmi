  noStroke();
  fill(28, 92, 132);
  rect(400, 0, 400, 180);
  fill(23, 74, 124);
  rect(400, 180, 480, 400);
  fill(187, 216, 236);
  rect(400, 120, 480, 80);
  fill(99, 29, 33);
  ellipse(624, 100, 250, 250);
  fill(233, 145, 75);
  ellipse(610, 88, 215, 215);
  fill(227, 176, 135);
  noStroke();
  rect(600, 80, 10, 35);
  fill(99, 37, 37);
  rect(610, 80, 5, 35);
  quad(610, 135, 590, 120, 590, 120, 625, 120);
  fill(255, 255, 255);
  ellipse(595, 80, 10, 5);
  ellipse(620, 80, 10, 5);
  fill(0, 0, 0);
  ellipse(595, 80, 5, 5);
  ellipse(620, 80, 5, 5);
  rect(520, 300, 200, 100);
